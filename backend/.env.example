# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=npl_pdp_audit
MONGODB_COLLECTION_PREFIX=pdp

# DSX (Dell GenAI gateway via csoutils DSXClient)
DSX_BASE_URL=https://aia.gateway.dell.com/genai/dev/v1
DSX_CLIENT_ID=your-dsx-client-id
DSX_CLIENT_SECRET=your-dsx-client-secret
DSX_API_KEY=your-dsx-api-key
DSX_AUTH_METHOD=client
DSX_MODEL=gpt-oss-120b
DSX_VERIFY_TLS=true
DSX_CA_BUNDLE=
DSX_JSON_MODE=true
DSX_TIMEOUT_SECONDS=60.0

# Playwright and crawling
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_CONCURRENT=2
PLAYWRIGHT_SAME_HOST_DELAY_MS=2000
PLAYWRIGHT_HEADLESS=true
HTML_CAPTURE_MAX_BYTES=5000000
CRAWL_MAX_CONCURRENT=2
CRAWL_SAME_HOST_DELAY_MS=2000
CRAWL_MAX_DEPTH=2
CRAWL_DEFAULT_PAGE_LIMIT=25

# Dell SMTP relay (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=30.0

# Scheduling
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=30
SCHEDULER_TIMEZONE=UTC

# Audit execution
DEMO_MODE=true
REPORT_BRAND_NAME=NPL PDP Audit Copilot

# Application
APP_NAME=NPL PDP Audit
APP_VERSION=0.1.0
DEBUG=false
